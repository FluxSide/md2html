{
  "name": "md2html",
  "version": "1.0.0",
  "private": true,
  "description": "A small CLI tool to convert Markdown files into styled HTML.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "md2html": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/index.ts",
    "md2html": "node --import tsx/esm src/index.ts",
    "test": "node --import tsx/esm src/test.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
